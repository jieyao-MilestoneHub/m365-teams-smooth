        "tool": "cast_verdict",
        "thread_id": "<thread-id>",
        "verdict_type": "request_revision",
        "selected_plan": "feasible"
      }
    },
    {
      "type": "Action.Execute",
      "title": "reject",
      "verb": "cast_verdict",
      "data": {
        "tool": "cast_verdict",
        "thread_id": "<thread-id>",
