      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "Proposed plan: Track each spoken follow-up as a task with its owner and due date; schedule the review that was proposed without one.",
      "wrap": true,
      "weight": "Bolder"
    },
    {
      "type": "TextBlock",
      "text": "• planner.create_task",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "• planner.create_task",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "• planner.create_task",
      "wrap": true
    },
    {
      "type": "TextBlock",
