{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "AI Change Court",
      "wrap": true,
      "weight": "Bolder"
    },
    {
      "type": "TextBlock",
      "text": "create action items from standup",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "Risk: LOW",
      "wrap": true,
      "weight": "Bolder",
      "color": "Good"
    },
    {
      "type": "TextBlock",
      "text": "Impact evidence",
      "wrap": true,
      "weight": "Bolder"
    },
    {
      "type": "TextBlock",
      "text": "• [teams] 4 spoken follow-up(s) in the standup discussion",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "• [outlook] Calendar events near the proposed review slot",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "grounded in 6 governance fact(s) — see the run page",
      "wrap": true,
      "isSubtle": true,
      "spacing": "Small"
    },
    {
      "type": "TextBlock",
      "text": "Proposed plan: Track each spoken follow-up as a task with its owner and due date; schedule the review that was proposed without one.",
      "wrap": true,
      "weight": "Bolder"
    },
    {
      "type": "TextBlock",
      "text": "• planner.create_task",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "• planner.create_task",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "• planner.create_task",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "• outlook.create_event",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "Approval required: none — the requester's confirmation executes it.",
      "wrap": true,
      "weight": "Bolder",
      "color": "Good"
    },
    {
      "type": "Input.Text",
      "id": "note",
      "isMultiline": true,
      "placeholder": "Why should this be approved? (required to send)",
      "isRequired": true,
      "errorMessage": "A note is required."
    },
    {
      "type": "TextBlock",
      "text": "🧠 Prosecutor: Gathered 3 evidence item(s); tags: meeting.action_items_found. No high-severity findings.",
      "wrap": true,
      "isSubtle": true,
      "spacing": "Small"
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "Send for approval",
      "verb": "send_for_approval",
      "data": {
        "tool": "send_for_approval",
        "thread_id": "<thread-id>"
      }
    },
    {
      "type": "Action.Execute",
      "title": "Give up",
      "verb": "withdraw_change",
      "data": {
        "tool": "withdraw_change",
        "thread_id": "<thread-id>"
      }
    }
  ]
}
