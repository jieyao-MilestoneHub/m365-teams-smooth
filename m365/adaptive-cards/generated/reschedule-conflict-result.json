{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "✅ Safe alternative executed",
      "wrap": true,
      "weight": "Bolder",
      "color": "Good"
    },
    {
      "type": "TextBlock",
      "text": "Refused the request as posed; ran the safer plan instead.",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "4 step(s) predicted (dry-run)",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "Audit: <audit-id>",
      "wrap": true,
      "isSubtle": true,
      "spacing": "Small"
    }
  ]
}
