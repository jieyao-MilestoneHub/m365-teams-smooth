{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "AI Change Court",
      "wrap": true,
      "weight": "Bolder"
    },
    {
      "type": "TextBlock",
      "text": "give the vendor access to Project X until the campaign is done",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "Risk: HIGH",
      "wrap": true,
      "weight": "Bolder",
      "color": "Attention"
    },
    {
      "type": "TextBlock",
      "text": "⛔ REJECTED as requested — proposing a safer alternative",
      "wrap": true,
      "weight": "Bolder",
      "color": "Attention"
    },
    {
      "type": "TextBlock",
      "text": "Grant least-privilege read-only access to /ProjectX/LaunchAssets until 2026-06-30, then auto-revoke.",
      "wrap": true,
      "color": "Attention"
    },
    {
      "type": "TextBlock",
      "text": "⚠ Decisive evidence",
      "wrap": true,
      "weight": "Bolder",
      "color": "Attention"
    },
    {
      "type": "TextBlock",
      "text": "• [sharepoint] '/ProjectX' holds customer data",
      "wrap": true,
      "weight": "Bolder"
    },
    {
      "type": "TextBlock",
      "text": "    ↳ External access should be least-privilege and time-boxed, with an explicit revoke date. (Access Control Policy §4.3)",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "Impact evidence",
      "wrap": true,
      "weight": "Bolder"
    },
    {
      "type": "TextBlock",
      "text": "• [request] Requested access has no end date ('until done')",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "• [request] Requested scope '/ProjectX' is broader than necessary",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "• [knowledge] grounded governance facts",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "    ↳ External access should be least-privilege and time-boxed, with an explicit revoke date. (Access Control Policy §4.3)",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "Safe alternative: Grant least-privilege read-only access to /ProjectX/LaunchAssets until 2026-06-30, then auto-revoke.",
      "wrap": true,
      "weight": "Bolder"
    },
    {
      "type": "TextBlock",
      "text": "• sharepoint.grant_folder_permission",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "• entra.invite_guest",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "• entra.schedule_access_revoke",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "Approvers required (all): manager, security_lead",
      "wrap": true
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "accept_alternative",
      "data": {
        "tool": "cast_verdict",
        "thread_id": "<thread-id>",
        "verdict_type": "accept_alternative",
        "selected_plan": "safe_alternative"
      }
    },
    {
      "type": "Action.Submit",
      "title": "request_revision",
      "data": {
        "tool": "cast_verdict",
        "thread_id": "<thread-id>",
        "verdict_type": "request_revision",
        "selected_plan": "safe_alternative"
      }
    },
    {
      "type": "Action.Submit",
      "title": "reject",
      "data": {
        "tool": "cast_verdict",
        "thread_id": "<thread-id>",
        "verdict_type": "reject",
        "selected_plan": "safe_alternative"
      }
    }
  ]
}
