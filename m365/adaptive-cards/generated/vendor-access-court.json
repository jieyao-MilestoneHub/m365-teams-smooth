{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "AI Change Court",
      "wrap": true,
      "weight": "Bolder"
    },
    {
      "type": "TextBlock",
      "text": "give the vendor access to Project X until the campaign is done",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "Risk: HIGH",
      "wrap": true,
      "weight": "Bolder",
      "color": "Attention"
    },
    {
      "type": "TextBlock",
      "text": "⛔ REJECTED as requested — proposing a safer alternative",
      "wrap": true,
      "weight": "Bolder",
      "color": "Attention"
    },
    {
      "type": "TextBlock",
      "text": "Grant least-privilege read-only access to /ProjectX/LaunchAssets until 2026-06-30, then auto-revoke.",
      "wrap": true,
      "color": "Attention"
    },
    {
      "type": "TextBlock",
      "text": "⚠ Decisive evidence",
      "wrap": true,
      "weight": "Bolder",
      "color": "Attention"
    },
    {
      "type": "TextBlock",
      "text": "• [sharepoint] '/ProjectX' holds customer data",
      "wrap": true,
      "weight": "Bolder"
    },
    {
      "type": "TextBlock",
      "text": "    ↳ Third-Party Vendor & Contractor Access Policy — Principle of least privilege; Third-Party Vendor & Contractor Access Policy — Purpose and scope; Third-Party Vendor & Contractor Access Policy — Periodic access review",
      "wrap": true,
      "isSubtle": true,
      "spacing": "Small"
    },
    {
      "type": "TextBlock",
      "text": "Impact evidence",
      "wrap": true,
      "weight": "Bolder"
    },
    {
      "type": "TextBlock",
      "text": "• [request] Requested access has no end date ('until done')",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "• [request] Requested scope '/ProjectX' is broader than necessary",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "grounded in 6 governance fact(s) — see the run page",
      "wrap": true,
      "isSubtle": true,
      "spacing": "Small"
    },
    {
      "type": "TextBlock",
      "text": "Safe alternative: Grant least-privilege read-only access to /ProjectX/LaunchAssets until 2026-06-30, then auto-revoke.",
      "wrap": true,
      "weight": "Bolder"
    },
    {
      "type": "TextBlock",
      "text": "• sharepoint.grant_folder_permission",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "• entra.invite_guest",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "• entra.schedule_access_revoke",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "Approvers required (all): manager, security_lead",
      "wrap": true
    },
    {
      "type": "Input.Text",
      "id": "note",
      "isMultiline": true,
      "placeholder": "Why should this be approved? (required to send)",
      "isRequired": true,
      "errorMessage": "A note is required."
    },
    {
      "type": "TextBlock",
      "text": "🧠 Prosecutor: Gathered 4 evidence item(s); tags: access.ambiguous_duration, access.overbroad_scope, data.customer_data_present. Decisive: '/ProjectX' holds customer data",
      "wrap": true,
      "isSubtle": true,
      "spacing": "Small"
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "Send for approval",
      "verb": "send_for_approval",
      "data": {
        "tool": "send_for_approval",
        "thread_id": "<thread-id>"
      }
    },
    {
      "type": "Action.Execute",
      "title": "Give up",
      "verb": "withdraw_change",
      "data": {
        "tool": "withdraw_change",
        "thread_id": "<thread-id>"
      }
    }
  ]
}
