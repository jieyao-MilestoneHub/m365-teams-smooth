{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "AI Change Court",
      "wrap": true,
      "weight": "Bolder"
    },
    {
      "type": "TextBlock",
      "text": "post the Project X weekly report",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "Risk: LOW",
      "wrap": true,
      "weight": "Bolder",
      "color": "Good"
    },
    {
      "type": "TextBlock",
      "text": "Impact evidence",
      "wrap": true,
      "weight": "Bolder"
    },
    {
      "type": "TextBlock",
      "text": "• [github] 4 issue(s) closed recently",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "• [planner] 2 task(s) tracked this week",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "• [outlook] 1 meeting(s) on the calendar",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "grounded in 6 governance fact(s) — see the run page",
      "wrap": true,
      "isSubtle": true,
      "spacing": "Small"
    },
    {
      "type": "TextBlock",
      "text": "Proposed plan: Aggregate the week's activity once and post it to the project channel.",
      "wrap": true,
      "weight": "Bolder"
    },
    {
      "type": "TextBlock",
      "text": "• teams.post_message",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "Approval required: none — the requester's confirmation executes it.",
      "wrap": true,
      "weight": "Bolder",
      "color": "Good"
    },
    {
      "type": "Input.Text",
      "id": "note",
      "isMultiline": true,
      "placeholder": "Why should this be approved? (required to send)",
      "isRequired": true,
      "errorMessage": "A note is required."
    },
    {
      "type": "TextBlock",
      "text": "🧠 Prosecutor: Gathered 4 evidence item(s); tags: report.activity_collected. No high-severity findings.",
      "wrap": true,
      "isSubtle": true,
      "spacing": "Small"
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "Send for approval",
      "verb": "send_for_approval",
      "data": {
        "tool": "send_for_approval",
        "thread_id": "<thread-id>"
      }
    },
    {
      "type": "Action.Execute",
      "title": "Give up",
      "verb": "withdraw_change",
      "data": {
        "tool": "withdraw_change",
        "thread_id": "<thread-id>"
      }
    }
  ]
}
