{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "Verdict recorded",
      "wrap": true,
      "weight": "Bolder"
    },
    {
      "type": "TextBlock",
      "text": "✓ intake → ✓ impact → ✓ options → ✓ policy → ✓ verdict → ✓ execute → ✓ verify → ✓ audit",
      "wrap": true,
      "isSubtle": true,
      "spacing": "Small"
    },
    {
      "type": "TextBlock",
      "text": "Status: done",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "Audit: <audit-id>",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "• s1: dry_run (predicted)",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "    ↩ rollback: restore the prior announcement / delete the escalation thread or post",
      "wrap": true
    }
  ]
}
