# Copy to terraform.tfvars and fill in. Never commit terraform.tfvars (it is gitignored).

subscription_id = "00000000-0000-0000-0000-000000000000"
azure_tenant_id = "00000000-0000-0000-0000-000000000000" # tenant of the Azure subscription (runtime resources)
entra_tenant_id = "00000000-0000-0000-0000-000000000000" # M365 tenant for the app registration / sign-in (may differ)
location        = "eastus"

# Optional overrides:
# name             = "changecourt"   # base name / DNS label
# min_replicas     = 0               # 1 for a warm demo (no cold start), at higher idle cost
# force_all_mock   = true            # keep mocks for a reliable demo
# integration_mode = "github:real"   # used only when force_all_mock = false
# github_token     = ""              # only for the real GitHub adapter
# github_repo      = ""              # owner/name

# Real Microsoft Graph evidence (set force_all_mock = false and
# integration_mode = "github:real,outlook:real,sharepoint:real" to use these). All three graph_*
# values are required together; omit any and Outlook/SharePoint fall back to mock.
# graph_tenant_id      = ""          # app-only client-credentials tenant
# graph_client_id      = ""          # app (client) id
# graph_client_secret  = ""          # app secret (stored as a Container App secret)
# outlook_calendar_upn = ""          # UPN whose calendar holds the security-review event
# sharepoint_site_id   = ""          # site id whose library holds the ProjectX folders

# Knowledge grounding (Azure AI Search agentic retrieval; all optional — omit to stay on the
# offline fallback). The resource ids grant the Container App's identity its data-plane roles.
# knowledge_search_endpoint    = ""  # https://<search>.search.windows.net
# knowledge_base_name          = ""  # knowledge base (agent) name
# knowledge_source_name        = ""  # knowledge source name
# knowledge_search_resource_id = ""  # /subscriptions/.../searchServices/<name>
# knowledge_openai_resource_id = ""  # /subscriptions/.../accounts/<name>
