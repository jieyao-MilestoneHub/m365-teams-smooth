# Copy to .env and fill in. Never commit a real .env.

# --- Persistence ---
# SQLAlchemy database URL. Defaults to a local SQLite file.
DB_URL=sqlite:///./data/app.db

# --- Agent behavior ---
# Whether new decisions default to dry-run (no external side effects).
DRY_RUN_DEFAULT=true
# Boundary cap on a submitted change request; longer requests are rejected, never truncated.
MAX_REQUEST_CHARS=1000
# Cap on the additional reads the agentic evidence loop may execute per trial.
MAX_AGENTIC_READS=5

# --- Policy rule packs ---
# Path to a YAML rule-pack file extending the court's governance with your own scenarios
# (see docs/extending.md and assets/policy-packs/example.yaml). File packs append to the
# built-in defaults unless the file sets include_defaults: false. Empty -> built-ins only.
POLICY_PACKS_PATH=

# --- Integrations ---
# Per-system selection of real vs mock adapters, comma-separated "system:mode".
# Anything not listed falls back to mock.
INTEGRATION_MODE=github:real
# Force every integration into mock mode (runs with zero external credentials).
FORCE_ALL_MOCK=false
# Required only when the GitHub adapter runs in real mode. Use a token scoped to a throwaway repo.
GITHUB_TOKEN=
# Target repository for the real GitHub adapter, as "owner/name".
GITHUB_REPO=

# --- Microsoft Graph (real evidence + contained writes) ---
# The headline (Informed Approval) grounds the GitHub milestone by default; add outlook:real to read
# the real calendar conflict it collides with. Set
# INTEGRATION_MODE=github:real,outlook:real,sharepoint:real,teams:real to also ground the additional
# capabilities (Customer Promise's Outlook security-review event, Vendor Access's SharePoint
# customer-data folder); crm/planner/entra stay mock. Writes stay dry-run unless DRY_RUN_DEFAULT=false.
# App-only auth; the Entra app needs admin-consented Calendars.ReadWrite + Mail.ReadWrite (Outlook
# evidence + event/draft writes), Sites.ReadWrite.All (SharePoint evidence + grant), and
# TeamsActivity.Send (Teams notifications — see TEAMS_NOTIFY_RECIPIENT).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# The user (UPN) whose calendar holds the demo events — the Board-review conflict the headline reads,
# and the "SSO Security Review" event the Customer Promise capability reads.
OUTLOOK_CALENDAR_UPN=
# The SharePoint site id whose default library holds the ProjectX folders (Vendor Access capability).
SHAREPOINT_SITE_ID=

# --- LLM provider ---
# Leave empty to use the offline fake provider + deterministic request parser.
LLM_API_KEY=
LLM_MODEL=
# Azure OpenAI for agentic request parsing. Set the endpoint + deployment (and FORCE_ALL_MOCK=false)
# to enable the LLM-backed parser; it falls back to deterministic parsing on any failure. Auth is
# keyless via DefaultAzureCredential (`az login` / managed identity) unless LLM_API_KEY is set.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
# Optional cheaper/faster deployment for lightweight call sites (request parsing, the deliberation
# trace); leave empty to run every call site on AZURE_OPENAI_DEPLOYMENT.
AZURE_OPENAI_DEPLOYMENT_FAST=
AZURE_OPENAI_API_VERSION=2024-10-21
# Output ceiling per LLM call (the call sites need small JSON objects, never long text).
LLM_MAX_TOKENS=1024
# Deliberation-trace cadence: "reuse" (only when a role already produced prose), "always", or "off".
DELIBERATION_LLM=reuse

# --- Knowledge / Foundry IQ ---
# Leave the endpoint empty to use the offline fake knowledge provider. When set (and FORCE_ALL_MOCK
# is false), grounding uses a Foundry IQ knowledge base over Azure AI Search. Auth is keyless via
# DefaultAzureCredential (run `az login` locally / managed identity when hosted) — no key here.
KNOWLEDGE_SEARCH_ENDPOINT=
KNOWLEDGE_BASE_NAME=
KNOWLEDGE_SOURCE_NAME=
# Query planning depth before hybrid + semantic rerank: "minimal" | "low" | "medium".
KNOWLEDGE_REASONING_EFFORT=medium
# Offline grounding corpus directory; empty -> the bundled assets/knowledge-corpus.
KNOWLEDGE_CORPUS_DIR=

# --- Input shield / guardrail ---
# Screens third-party content (the request, gathered evidence) for prompt injection before the LLM
# reasons over it. Leave the endpoint empty to use the offline heuristic shield; set it (and
# FORCE_ALL_MOCK false) to use Azure AI Content Safety Prompt Shields — keyless via
# DefaultAzureCredential. GUARDRAIL_BLOCKING=false screens-and-logs without blocking.
CONTENT_SAFETY_ENDPOINT=
GUARDRAIL_BLOCKING=true

# --- MCP OAuth2 (resource server) ---
# A local dev issuer is used when these are unset; set them to point at Entra ID in a real tenant.
# For Entra ID, ISSUER and JWKS_URL are tenant-scoped, e.g.:
#   OAUTH_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
#   OAUTH_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
#   OAUTH_AUDIENCE=api://<app-id>  (the app's Application ID URI)
OAUTH_ISSUER=
OAUTH_AUDIENCE=
OAUTH_JWKS_URL=

# --- Observability ---
# Logger verbosity and output shape. Use "text" for readable local-dev logs; "json" for hosted.
LOG_LEVEL=INFO
LOG_FORMAT=json
# Mask PII (emails, phone numbers) in JSON log output; the audit trail keeps full data.
LOG_REDACTION_ENABLED=true
# Default per-request timeout (seconds) for adapters without an explicit one.
HTTP_TIMEOUT_SECONDS=10
# LLM-backed parser timeout (seconds); on expiry it falls back to deterministic parsing.
LLM_TIMEOUT_SECONDS=30
# Transient-failure retry budget for the LLM client (the SDK owns backoff and retry-after).
LLM_MAX_RETRIES=2
# Overall wall-clock guard (seconds) on a single graph run; the checkpoint stays resumable.
GRAPH_TIMEOUT_SECONDS=60
# Idempotency-aware retry policy for transient adapter failures (exponential backoff + jitter).
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_BASE_SECONDS=0.2
RETRY_BACKOFF_MAX_SECONDS=2
# Toggle the in-process metrics registry (exposed as the court://metrics MCP resource).
METRICS_ENABLED=true
# Retention window (days) for finished trials' working storage (checkpoints + verdict claims);
# the audit log is permanent and never purged.
RETENTION_DAYS=30

# --- Approvals (separation of duties) ---
# Map approver roles to identities (UPN or oid), comma-separated "role:identity" (a role may
# repeat), e.g. "eng_lead:lead@contoso.com,security_lead:ciso@contoso.com". Required for any
# deployment whose changes convene approvers — every decision is cast by an authorized identity;
# without a directory a quorum-bearing trial can be submitted and sent but never decided.
# No-approver changes execute on the requester's own confirmation either way.
APPROVER_DIRECTORY=

# --- Notifications (approval channel) ---
# "off" (default) or "teams". "teams" pushes approval events to the approvers'/requester's Teams
# activity feed via Microsoft Graph — reuses GRAPH_* credentials and additionally needs the
# admin-consented application permission TeamsActivity.Send. Notifications use the reserved
# systemDefault activity type (custom manifest types are dropped silently by the feed). Delivery
# is best-effort; failures never block the approval workflow.
NOTIFY_MODE=off
# Click-through target of the toast — MUST be a Teams deep link ("https://teams.microsoft.com/l/...");
# Graph rejects a bare domain. Leave empty to derive it: the bot chat when BOT_APP_ID is set (the
# toast lands on the proactive approval card), else the Teams home.
NOTIFY_LINK_URL=
# The catalog app id of the installed Teams app (disambiguates which app the toast belongs to).
NOTIFY_TEAMS_APP_ID=
# When INTEGRATION_MODE includes teams:real, downstream Teams writes (the weekly-report post and the
# reschedule announcement) send a REAL Graph activity-feed notification to this UPN (reuses GRAPH_* +
# the admin-consented TeamsActivity.Send). A real channel post/read is a protected Graph API and is
# intentionally out of scope. Empty -> teams stays mock.
TEAMS_NOTIFY_RECIPIENT=
# POST each approval event (request / decision / acknowledgement) with the trial's evidence
# packet — change, impact evidence with citations, risk factors, plan or safe alternative, quorum,
# run-page link — to this URL, so an existing ticket or change-management workflow can attach the
# analysis. Independent of NOTIFY_MODE; best-effort. Empty -> the channel is off. A reference
# receiver that posts the packet onto an existing GitHub issue ships in
# backend/scripts/evidence_receiver.py.
EVIDENCE_WEBHOOK_URL=
# Optional bearer token sent in the Authorization header of each webhook POST.
EVIDENCE_WEBHOOK_TOKEN=

# --- Bot surface (POST /api/messages) ---
# The Azure Bot's app registration. Leave all four empty for local development — the endpoint then
# uses anonymous Bot Framework auth, which is what the Microsoft 365 Agents Playground / Emulator
# expects. Set them when the backend runs behind Azure Bot Service so Teams can authenticate the
# channel and the bot can send proactive approval cards.
BOT_APP_ID=
BOT_APP_PASSWORD=
BOT_APP_TYPE=MultiTenant
BOT_APP_TENANT_ID=
# Channel service URL used when the bot must CREATE a conversation (recipient never contacted it).
# The default routes via Teams' global entry; override with the regional URL from a captured
# conversation reference if conversation creation fails.
BOT_SERVICE_URL=https://smba.trafficmanager.net/teams/

# --- Deployment ---
# Public HTTPS origin this backend is reachable at (no trailing slash), e.g.
# https://change-court.example.com. The MCP resource URL the agent calls is "{PUBLIC_BASE_URL}/mcp".
# Leave empty for local development (defaults to http://localhost:8000).
PUBLIC_BASE_URL=

# --- Run page (read-only pipeline inspection) ---
# HMAC secret signing per-trial run-page deep links ("/runs/{thread_id}?t=...").
# Empty -> the run page is disabled entirely (requests 404).
RUN_LINK_SECRET=
